# 自动检测文本文件并规范化换行符
* text=auto

# Shell 脚本始终使用 LF
*.sh text eol=lf

# Python 文件使用 LF
*.py text eol=lf

# JavaScript/TypeScript 文件使用 LF
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# 配置文件使用 LF
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary
